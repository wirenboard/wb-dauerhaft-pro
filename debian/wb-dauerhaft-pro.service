[Unit]
Description=Wiren Board Dauerhaft PRO RS-485 driver
After=mosquitto.service wb-mqtt-serial.service

[Service]
Type=exec
ExecStart=/usr/bin/wb-dauerhaft-pro
Restart=on-failure
RestartSec=10
# 6 = bad config (do not restart-loop until the user fixes it), 2 = could not
# start; 7 = clean exit on a signal, counted as success.
RestartPreventExitStatus=2 6
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target
