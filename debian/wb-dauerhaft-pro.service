[Unit]
Description=Wiren Board MQTT driver for Dauerhaft PRO RS-485 actuators
After=mosquitto.service wb-mqtt-serial.service
Wants=wb-mqtt-serial.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/wb-dauerhaft-pro
Restart=on-failure
RestartSec=10
# A bad config exits 78 (EX_CONFIG) — do not restart-loop on it; genuine
# transient crashes (other non-zero codes) still restart.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
